# ---------------------------------------------------------------------------
# Supabase — shared by both apps in this repo (SimSoc and BMC)
# ---------------------------------------------------------------------------

# Project URL and anon key: Supabase dashboard -> Project Settings -> API.
# Both are safe to expose to the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY — never prefix with NEXT_PUBLIC_ and never
# reference it from a client component. Used by the BMC leads tracker to send
# participant invite emails. Without it, everything else still works; the
# "Convert to participant" button reports that invites must be sent from the
# Supabase dashboard instead.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployment, used to build auth email redirect links.
# Local: http://localhost:3000 — production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic — BMC participant Assistant
# ---------------------------------------------------------------------------

# SERVER ONLY. Read exclusively inside the /api/bmc/chat route handler.
ANTHROPIC_API_KEY=

# Sonnet-class model for chat cost and latency. Override to trade cost for
# capability (for example claude-opus-5).
ANTHROPIC_MODEL=claude-sonnet-5
