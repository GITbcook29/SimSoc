# ===========================================================================
# Two apps, two Supabase projects.
#
# SimSoc and BMC each own a separate Supabase project. They share one Next.js
# deployment, so which project a request talks to is decided purely by which
# of these variables the code path reads.
#
# Auth sessions don't collide: @supabase/ssr names its cookie after the
# project ref, so a user can be signed into both apps at once.
# ===========================================================================

# ---------------------------------------------------------------------------
# SimSoc Supabase project — routes outside /bmc
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# BMC Supabase project — /bmc/* routes
#
# A different project from the two above. Copy these from the BMC project's
# Project Settings -> API page, not SimSoc's.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_BMC_SUPABASE_URL=
NEXT_PUBLIC_BMC_SUPABASE_ANON_KEY=

# Service role key for the BMC project. SERVER ONLY — never prefix with
# NEXT_PUBLIC_ and never reference it from a client component. Used only to
# send participant invite emails from the leads tracker. Without it everything
# else still works; the "Convert to participant" button reports that invites
# must be sent from the Supabase dashboard instead.
BMC_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Shared deployment settings
# ---------------------------------------------------------------------------

# Public origin of the deployment, used to build auth email redirect links.
# Local: http://localhost:3000 — production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic — BMC participant Assistant
# ---------------------------------------------------------------------------

# SERVER ONLY. Read exclusively inside the /api/bmc/chat route handler.
ANTHROPIC_API_KEY=

# Sonnet-class model for chat cost and latency. Override to trade cost for
# capability (for example claude-opus-5).
ANTHROPIC_MODEL=claude-sonnet-5
